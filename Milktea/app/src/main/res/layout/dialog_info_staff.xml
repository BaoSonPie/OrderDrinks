<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/rounded_corners">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edtStaffName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ tên"
            android:paddingHorizontal="10dp"

            android:background="@drawable/gradient_logintext"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtStaffUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên đăng nhập"
            android:paddingHorizontal="10dp"
            android:background="@drawable/gradient_logintext"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtStaffPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu"
            android:paddingHorizontal="10dp"
            android:background="@drawable/gradient_logintext"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtStaffPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại"
            android:paddingHorizontal="10dp"
            android:background="@drawable/gradient_logintext"
            android:inputType="phone"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtStaffEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:paddingHorizontal="10dp"
            android:background="@drawable/gradient_logintext"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtStaffRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vai trò"
            android:paddingHorizontal="10dp"
            android:background="@drawable/gradient_logintext"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đóng"
            android:backgroundTint="#FBC02D"
            android:textColor="@android:color/black"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
